#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

die() {
  printf 'install-charmfile: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    "Usage:" \
    "  install-charmfile plan [--source PATH_OR_GIT] [--preset core|standard|full] [--with-browser] [--with PACK]" \
    "  install-charmfile install [--source PATH_OR_GIT] [--preset core|standard|full] [--with-browser] [--with PACK] --yes" \
    "  install-charmfile update --yes" \
    "  install-charmfile doctor [--require-live-chrome] [--after-update]" \
    "  install-charmfile init [--repo PATH] [--id ID] [--name NAME] [--repository IDENTITY] [--memory-project NAME] [--yes]" \
    "  install-charmfile resume [--repo PATH]" \
    "  install-charmfile status [--repo PATH]" \
    "" \
    "The default preset is standard: Charmfile Core plus Charmfile Memory." \
    "Memory activation, browser automation, specialist packs, and cloud mode remain separate choices."
}

require_macos() {
  [ "$(uname -s)" = "Darwin" ] ||
    die "this Charmfile release supports macOS only"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    die "required command is unavailable: $1"
}

ensure_jq() {
  if command -v jq >/dev/null 2>&1; then
    return
  fi
  command -v brew >/dev/null 2>&1 ||
    die "jq is missing and Homebrew is unavailable"
  printf 'Installing required JSON helper: jq\n'
  brew install jq
  require_command jq
}

run_codex_with_git_config() {
  local xdg_git_config
  xdg_git_config="${XDG_CONFIG_HOME:-$HOME/.config}/git/config"

  if [ -n "${GIT_CONFIG_GLOBAL:-}" ] ||
    [ -f "$HOME/.gitconfig" ] ||
    [ -f "$xdg_git_config" ]; then
    codex "$@"
  else
    GIT_CONFIG_GLOBAL=/dev/null codex "$@"
  fi
}

core_script() {
  printf '%s/plugins/charmfile-core/skills/charmfile-setup/scripts/charmfile\n' "$1"
}

browser_script() {
  printf '%s/plugins/charmfile-browser/skills/browser-setup/scripts/charmfile-browser\n' "$1"
}

marketplace_root() {
  require_command jq
  codex plugin marketplace list --json |
    jq -r '.marketplaces[] | select(.name == "charmfile") | .root' |
    sed -n '1p'
}

marketplace_source_type() {
  require_command jq
  codex plugin marketplace list --json |
    jq -r '
      .marketplaces[]
      | select(.name == "charmfile")
      | .marketplaceSource.sourceType
    ' |
    sed -n '1p'
}

plugin_names() {
  local root="$1"
  local manifest="$root/.agents/plugins/marketplace.json"
  [ -f "$manifest" ] || die "marketplace manifest is missing: $manifest"
  if command -v jq >/dev/null 2>&1; then
    jq -r '.plugins[].name' "$manifest"
  else
    find "$root/plugins" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; |
      sort
  fi
}

selected_plugins=("")

plugin_selected() {
  local expected="$1"
  local selected
  for selected in "${selected_plugins[@]}"; do
    [ "$selected" = "$expected" ] && return 0
  done
  return 1
}

append_selected_plugin() {
  local plugin_name="$1"
  [ -n "$plugin_name" ] || return
  if ! plugin_selected "$plugin_name"; then
    selected_plugins+=("$plugin_name")
  fi
}

normalize_plugin_name() {
  case "$1" in
    charmfile-*) printf '%s\n' "$1" ;;
    *) printf 'charmfile-%s\n' "$1" ;;
  esac
}

plugin_exists() {
  local root="$1"
  local expected="$2"
  plugin_names "$root" | grep -Fxq "$expected"
}

resolve_requested_plugins() {
  local root="$1"
  local plugin_name
  selected_plugins=("")
  case "$preset" in
    core)
      append_selected_plugin charmfile-core
      ;;
    standard)
      append_selected_plugin charmfile-core
      append_selected_plugin charmfile-memory
      ;;
    full)
      while IFS= read -r plugin_name; do
        [ -n "$plugin_name" ] || continue
        append_selected_plugin "$plugin_name"
      done < <(plugin_names "$root")
      ;;
    *)
      die "unknown preset: $preset"
      ;;
  esac
  if [ "$with_browser" = "true" ]; then
    append_selected_plugin charmfile-browser
  fi
  for plugin_name in "${additional_plugins[@]}"; do
    [ -n "$plugin_name" ] || continue
    append_selected_plugin "$plugin_name"
  done
  for plugin_name in "${selected_plugins[@]}"; do
    [ -n "$plugin_name" ] || continue
    plugin_exists "$root" "$plugin_name" ||
      die "selected pack is not in this marketplace: $plugin_name"
  done
}

resolve_installed_plugins() {
  local root="$1"
  local require_core="${2:-false}"
  local installed_json plugin_name
  installed_json="$(codex plugin list --json)"
  selected_plugins=("")
  while IFS= read -r plugin_name; do
    [ -n "$plugin_name" ] || continue
    if printf '%s\n' "$installed_json" |
      jq -e --arg id "$plugin_name@charmfile" '
        any(.installed[];
          .pluginId == $id and .installed == true
        )
      ' >/dev/null; then
      append_selected_plugin "$plugin_name"
    fi
  done < <(plugin_names "$root")
  if [ "$require_core" = "true" ] &&
    ! plugin_selected charmfile-core; then
    die "Charmfile Core is not installed; run install before update"
  fi
}

prepare_codex_home() {
  target_codex_home="${CODEX_HOME:-$HOME/.codex}"
  [ -n "$target_codex_home" ] || die "Codex home resolved to an empty path"
  mkdir -p "$target_codex_home"
}

show_plan() {
  local root="$1"
  local mode="$2"
  local core browser plugin_name
  core="$(core_script "$root")"
  [ -x "$core" ] || die "Core setup command is missing: $core"

  printf 'Charmfile install plan\n'
  printf '  operation: %s\n' "$mode"
  printf '  platform: macOS only\n'
  printf '  marketplace source: %s\n' "$marketplace_source"
  if [ "$mode" = "update" ]; then
    printf '  pack selection: preserve currently installed Charmfile packs\n'
  else
    printf '  preset: %s\n' "$preset"
  fi
  printf '  selected packs:\n'
  for plugin_name in "${selected_plugins[@]}"; do
    [ -n "$plugin_name" ] || continue
    printf '    - %s\n' "$plugin_name"
  done
  printf '  plugin behavior: install or refresh; unrelated plugins unchanged\n'
  if command -v jq >/dev/null 2>&1; then
    printf '  JSON helper: keep existing jq\n'
  else
    printf '  JSON helper: install jq with Homebrew after approval\n'
  fi
  printf '  memory runtime: available through the memory pack; vault activation remains separately approved\n'
  printf '  cloud mode: not configured by this operation\n'
  printf '  new terminal and Codex session required after apply\n'
  "$core" plan --scope user --with-path --with-profile --with-secrets
  if plugin_selected charmfile-browser; then
    browser="$(browser_script "$root")"
    [ -x "$browser" ] || die "Browser setup command is missing: $browser"
    "$browser" plan
  else
    printf '  browser automation: not selected\n'
  fi
}

install_plugins() {
  local root="$1"
  local plugin_name plugin_json
  for plugin_name in "${selected_plugins[@]}"; do
    [ -n "$plugin_name" ] || continue
    printf 'Installing plugin: %s@charmfile\n' "$plugin_name"
    plugin_json="$(codex plugin add "$plugin_name@charmfile" --json)" ||
      die "Codex failed to install $plugin_name@charmfile"
    if ! printf '%s\n' "$plugin_json" |
      jq -e --arg id "$plugin_name@charmfile" '.pluginId == $id' \
        >/dev/null; then
      die "Codex did not confirm installation of $plugin_name@charmfile"
    fi
  done
}

apply_managed_setup() {
  local root="$1"
  local core browser
  core="$(core_script "$root")"
  if plugin_selected charmfile-browser; then
    browser="$(browser_script "$root")"
    "$browser" install --yes
  fi
  install_plugins "$root"
  "$core" install \
    --scope user \
    --with-path \
    --with-profile \
    --with-secrets \
    --yes
}

doctor() {
  local root core browser installed_json plugin_name sidecar_report sidecar_score
  local browser_args
  local failures plugin_failures
  root="$(marketplace_root)"
  [ -n "$root" ] || die "the charmfile marketplace is not registered"
  core="$(core_script "$root")"
  failures=0
  resolve_installed_plugins "$root"

  printf 'Charmfile doctor\n'
  if ! plugin_selected charmfile-core; then
    printf '  [fail] Plugin is missing: charmfile-core\n'
    failures=$((failures + 1))
  elif ! "$core" doctor \
      --scope user \
      --with-path \
      --with-profile \
      --with-secrets; then
      failures=$((failures + 1))
  fi
  if plugin_selected charmfile-browser; then
    browser="$(browser_script "$root")"
    browser_args=(doctor)
    if [ "$require_live_chrome" = "true" ]; then
      browser_args+=(--require-live-chrome)
    fi
    if ! "$browser" "${browser_args[@]}"; then
      failures=$((failures + 1))
    fi
  elif [ "$require_live_chrome" = "true" ]; then
    printf '  [fail] Live Chrome was required but charmfile-browser is not installed\n'
    failures=$((failures + 1))
  else
    printf '  [note] Browser pack is not installed\n'
  fi

  installed_json="$(codex plugin list --json)"
  plugin_failures=0
  for plugin_name in "${selected_plugins[@]}"; do
    [ -n "$plugin_name" ] || continue
    if printf '%s\n' "$installed_json" |
      jq -e --arg id "$plugin_name@charmfile" '
        any(.installed[];
          .pluginId == $id and .installed == true and .enabled == true
        )
      ' >/dev/null; then
      printf '  [ok] Plugin: %s\n' "$plugin_name"
    else
      printf '  [fail] Plugin is missing or disabled: %s\n' "$plugin_name"
      plugin_failures=$((plugin_failures + 1))
    fi
  done
  if [ "$plugin_failures" -gt 0 ]; then
    failures=$((failures + plugin_failures))
  fi

  if [ "$after_update" = "true" ]; then
    printf 'Charmfile post-update verification\n'
    for feature_name in goals hooks memories multi_agent personality plugins unified_exec; do
      if codex --enable "$feature_name" features list 2>/dev/null |
        awk -v feature="$feature_name" \
          '$1 == feature && $NF == "true" { found = 1 } END { exit !found }'; then
        printf '  [ok] Codex feature supported: %s\n' "$feature_name"
      else
        printf '  [fail] Codex feature is unavailable: %s\n' "$feature_name"
        failures=$((failures + 1))
      fi
    done

    if command -v obsidian-sidecar >/dev/null 2>&1; then
      if sidecar_report="$(obsidian-sidecar doctor 2>/dev/null)" &&
        printf '%s\n' "$sidecar_report" |
          jq -e '
            (.critical_failures // 1) == 0 and
            (.score // 0) >= 80 and
            (.basic_memory // "") == "ok"
          ' >/dev/null; then
        sidecar_score="$(printf '%s\n' "$sidecar_report" | jq -r '.score')"
        printf '  [ok] Charmfile Memory engine: Sidecar score %s\n' "$sidecar_score"
      else
        printf '  [fail] Obsidian Sidecar health gate failed\n'
        failures=$((failures + 1))
      fi
    else
      if plugin_selected charmfile-memory; then
        printf '  [note] Charmfile Memory pack is installed; Sidecar activation is pending\n'
      else
        printf '  [note] Charmfile Memory is not installed\n'
      fi
    fi
  fi

  if [ "$failures" -gt 0 ]; then
    printf 'Charmfile result: %s required check(s) failed\n' "$failures"
    return 1
  fi
  printf 'Charmfile result: healthy\n'
  if [ "$after_update" = "true" ]; then
    printf 'Post-update result: healthy\n'
  fi
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command_name" in
  init|resume|status)
    project_command="$repo_root/scripts/charmfile-project"
    [ -x "$project_command" ] ||
      die "project continuity command is missing: $project_command"
    exec "$project_command" "$command_name" "$@"
    ;;
esac

approved="false"
require_live_chrome="false"
after_update="false"
marketplace_source="$repo_root"
preset="standard"
with_browser="false"
selection_options_set="false"
additional_plugins=("")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --source)
      [ "$#" -ge 2 ] || die "--source requires a local path or Git source"
      marketplace_source="$2"
      shift 2
      ;;
    --preset)
      [ "$#" -ge 2 ] || die "--preset requires core, standard, or full"
      preset="$2"
      selection_options_set="true"
      shift 2
      ;;
    --with-browser)
      with_browser="true"
      selection_options_set="true"
      shift
      ;;
    --with)
      [ "$#" -ge 2 ] || die "--with requires a Charmfile pack name"
      additional_plugins+=("$(normalize_plugin_name "$2")")
      selection_options_set="true"
      shift 2
      ;;
    --yes)
      approved="true"
      shift
      ;;
    --require-live-chrome)
      require_live_chrome="true"
      shift
      ;;
    --after-update)
      after_update="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

require_macos

case "$command_name" in
  plan)
    resolve_requested_plugins "$repo_root"
    show_plan "$repo_root" plan
    ;;
  install)
    [ "$approved" = "true" ] ||
      die "install requires --yes after the plan is approved"
    require_command codex
    require_command git
    resolve_requested_plugins "$repo_root"
    show_plan "$repo_root" install
    ensure_jq
    prepare_codex_home
    marketplace_json="$(
      run_codex_with_git_config \
        plugin marketplace add "$marketplace_source" --json
    )" || die "Codex failed to register the charmfile marketplace"
    if ! printf '%s\n' "$marketplace_json" |
      jq -e '.marketplaceName == "charmfile"' >/dev/null; then
      die "Codex did not confirm the charmfile marketplace registration"
    fi
    installed_root="$(marketplace_root)"
    [ -n "$installed_root" ] ||
      die "Codex did not register the charmfile marketplace"
    apply_managed_setup "$installed_root"
    doctor
    printf 'Open a new terminal, then start a new Codex session to load the PATH and plugins.\n'
    ;;
  update)
    [ "$selection_options_set" = "false" ] ||
      die "update preserves installed packs and does not accept selection options"
    [ "$approved" = "true" ] ||
      die "update requires --yes after the plan is approved"
    require_command codex
    require_command git
    require_command jq
    current_root="$(marketplace_root)"
    [ -n "$current_root" ] ||
      die "the charmfile marketplace is not registered"
    marketplace_source="$current_root"
    resolve_installed_plugins "$current_root" true
    show_plan "$current_root" update
    source_type="$(marketplace_source_type)"
    if [ "$source_type" = "git" ]; then
      run_codex_with_git_config \
        plugin marketplace upgrade charmfile --json >/dev/null
    else
      printf 'Local marketplace: using the current checkout without a Git refresh.\n'
    fi
    refreshed_root="$(marketplace_root)"
    [ -n "$refreshed_root" ] ||
      die "the refreshed charmfile marketplace is unavailable"
    for selected_plugin in "${selected_plugins[@]}"; do
      [ -n "$selected_plugin" ] || continue
      plugin_exists "$refreshed_root" "$selected_plugin" ||
        die "installed pack is missing from the refreshed marketplace: $selected_plugin"
    done
    apply_managed_setup "$refreshed_root"
    after_update="true"
    doctor
    printf 'Open a new terminal, then start a new Codex session to load the PATH and plugins.\n'
    ;;
  doctor)
    [ "$selection_options_set" = "false" ] ||
      die "doctor inspects installed packs and does not accept selection options"
    require_command codex
    require_command jq
    doctor
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    die "unknown command: $command_name"
    ;;
esac
