#!/bin/sh
# CHARMFILE MANAGED LIFECYCLE LAUNCHER
set -eu

command -v codex >/dev/null 2>&1 || {
  printf 'charmfile: codex is not on PATH\n' >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf 'charmfile: jq is not on PATH; rerun the browser setup doctor\n' >&2
  exit 1
}

marketplace_root="$(
  codex plugin marketplace list --json |
    jq -r '.marketplaces[] | select(.name == "charmfile") | .root' |
    sed -n '1p'
)"
[ -n "$marketplace_root" ] || {
  printf 'charmfile: the charmfile marketplace is not registered\n' >&2
  exit 1
}
lifecycle="$marketplace_root/scripts/install-charmfile"
[ -x "$lifecycle" ] || {
  printf 'charmfile: lifecycle command is missing: %s\n' "$lifecycle" >&2
  exit 1
}

exec "$lifecycle" "$@"
