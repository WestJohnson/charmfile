#!/usr/bin/env bash
set -euo pipefail

readonly SERVICE_PREFIX="dev.charmfile.codex-secrets"
readonly REGISTRY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/charmfile/secrets"
readonly REGISTRY_FILE="$REGISTRY_DIR/registry"

die() {
  printf 'codex-secrets: %s\n' "$*" >&2
  exit 1
}

restore_tty() {
  if [ -n "${saved_tty_state:-}" ]; then
    stty "$saved_tty_state" 2>/dev/null || true
  fi
}

valid_name() {
  case "$1" in
    ''|[0-9]*|*[!A-Za-z0-9_]*)
      die "invalid variable name: $1"
      ;;
  esac
}

ensure_registry() {
  mkdir -p "$REGISTRY_DIR"
  chmod 700 "$REGISTRY_DIR"
  touch "$REGISTRY_FILE"
  chmod 600 "$REGISTRY_FILE"
}

backend() {
  case "$(uname -s)" in
    Darwin)
      command -v security >/dev/null 2>&1 || die "macOS security command is unavailable"
      printf 'macos-keychain\n'
      ;;
    Linux)
      command -v secret-tool >/dev/null 2>&1 ||
        die "secret-tool is required on Linux; install a libsecret client first"
      printf 'libsecret\n'
      ;;
    *)
      die "this release supports macOS Keychain and Linux libsecret"
      ;;
  esac
}

remember() {
  local secret_name="$1"
  ensure_registry
  grep -Fxq -- "$secret_name" "$REGISTRY_FILE" || {
    printf '%s\n' "$secret_name" >> "$REGISTRY_FILE"
    sort -u -o "$REGISTRY_FILE" "$REGISTRY_FILE"
  }
}

forget() {
  local secret_name="$1"
  local registry_temp
  ensure_registry
  registry_temp="$(mktemp "$REGISTRY_DIR/registry.XXXXXX")"
  grep -Fxv -- "$secret_name" "$REGISTRY_FILE" > "$registry_temp" || true
  chmod 600 "$registry_temp"
  mv "$registry_temp" "$REGISTRY_FILE"
}

secret_get() {
  local secret_name="$1"
  case "$(backend)" in
    macos-keychain)
      security find-generic-password \
        -a "$USER" \
        -s "$SERVICE_PREFIX.$secret_name" \
        -w 2>/dev/null
      ;;
    libsecret)
      secret-tool lookup \
        service "$SERVICE_PREFIX" \
        account "$USER" \
        name "$secret_name"
      ;;
  esac
}

secret_set() {
  local secret_name="$1"
  local secret_value="$2"
  case "$(backend)" in
    macos-keychain)
      security add-generic-password \
        -U \
        -a "$USER" \
        -s "$SERVICE_PREFIX.$secret_name" \
        -l "Charmfile secret: $secret_name" \
        -w "$secret_value" >/dev/null
      ;;
    libsecret)
      printf '%s' "$secret_value" |
        secret-tool store \
          --label="Charmfile secret: $secret_name" \
          service "$SERVICE_PREFIX" \
          account "$USER" \
          name "$secret_name"
      ;;
  esac
}

secret_remove() {
  local secret_name="$1"
  case "$(backend)" in
    macos-keychain)
      security delete-generic-password \
        -a "$USER" \
        -s "$SERVICE_PREFIX.$secret_name" >/dev/null 2>&1
      ;;
    libsecret)
      secret-tool clear \
        service "$SERVICE_PREFIX" \
        account "$USER" \
        name "$secret_name"
      ;;
  esac
}

registry_mode() {
  if stat -f '%Sp' "$REGISTRY_FILE" >/dev/null 2>&1; then
    stat -f '%Sp' "$REGISTRY_FILE"
  else
    stat -c '%A' "$REGISTRY_FILE"
  fi
}

usage() {
  printf '%s\n' \
    "Usage:" \
    "  codex-secrets set NAME              Store or replace a secret" \
    "  codex-secrets set NAME --stdin      Read the value from standard input" \
    "  codex-secrets get NAME              Print a secret when injection is impossible" \
    "  codex-secrets has NAME              Test whether a secret exists" \
    "  codex-secrets list                  List names, never values" \
    "  codex-secrets remove NAME           Delete a secret" \
    "  codex-secrets run NAME... -- CMD    Inject secrets into one child process" \
    "  codex-secrets doctor                Verify the secret backend"
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  set)
    [ "$#" -ge 1 ] || die "set requires NAME"
    name="$1"
    shift
    valid_name "$name"
    if [ "${1:-}" = "--stdin" ]; then
      IFS= read -r value || true
    else
      [ -t 0 ] || die "interactive set requires a terminal; use --stdin"
      printf 'Value for %s: ' "$name" >&2
      saved_tty_state="$(stty -g)"
      trap restore_tty EXIT
      trap 'restore_tty; exit 130' HUP INT TERM
      stty -echo
      IFS= read -r value || true
      restore_tty
      trap - EXIT HUP INT TERM
      saved_tty_state=""
      printf '\n' >&2
    fi
    [ -n "${value:-}" ] || die "refusing to store an empty value"
    secret_set "$name" "$value"
    unset value
    remember "$name"
    printf 'Stored %s in %s.\n' "$name" "$(backend)"
    ;;
  get)
    [ "$#" -eq 1 ] || die "get requires NAME"
    valid_name "$1"
    secret_get "$1" || die "$1 not found"
    ;;
  has)
    [ "$#" -eq 1 ] || die "has requires NAME"
    valid_name "$1"
    secret_get "$1" >/dev/null
    ;;
  list)
    ensure_registry
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if secret_get "$name" >/dev/null; then
        printf '%s\n' "$name"
      else
        printf '%s (missing)\n' "$name"
      fi
    done < "$REGISTRY_FILE"
    ;;
  remove)
    [ "$#" -eq 1 ] || die "remove requires NAME"
    valid_name "$1"
    secret_remove "$1" || die "$1 not found"
    forget "$1"
    printf 'Removed %s.\n' "$1"
    ;;
  run)
    names=()
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
      valid_name "$1"
      names+=("$1")
      shift
    done
    [ "${1:-}" = "--" ] || die "run requires -- before the command"
    shift
    [ "$#" -gt 0 ] || die "run requires a command"
    for name in "${names[@]}"; do
      value="$(secret_get "$name")" || die "$name not found"
      export "$name=$value"
      unset value
    done
    exec "$@"
    ;;
  doctor)
    ensure_registry
    printf 'Backend: %s\n' "$(backend)"
    printf 'Registry: %s (%s)\n' "$REGISTRY_FILE" "$(registry_mode)"
    printf 'Stored names: %s\n' "$(grep -cve '^$' "$REGISTRY_FILE" || true)"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    die "unknown command: $command_name"
    ;;
esac
