#!/bin/sh
# CHARMFILE MANAGED PLAYWRIGHT WRAPPER
set -eu

runtime_root="${CHARMFILE_PLAYWRIGHT_RUNTIME:-$HOME/.local/share/charmfile/playwright-cli}"
runtime_cli="$runtime_root/node_modules/.bin/playwright-cli"

if [ ! -x "$runtime_cli" ]; then
  printf 'playwright-cli: Charmfile runtime is missing: %s\n' "$runtime_cli" >&2
  exit 1
fi

exec "$runtime_cli" "$@"
